# Portal IA · variables de entorno (copia este archivo como .env en la raíz del repositorio)

# Puerto y host del backend local
# PORTAL_PORT=4310
# PORTAL_HOST=127.0.0.1

# Carpeta de datos (SQLite por espacio). Relativa a la raíz del repositorio o absoluta.
# PORTAL_DATA_DIR=./data

# Rama principal en la que SIEMPRE se integra y se publica (HU-143).
# Si la carpeta del Portal no está en esta rama, el botón Integrar queda bloqueado.
# PORTAL_MAIN_BRANCH=main

# Carpeta donde cada proceso obtiene su worktree aislado (HU-011). Debe quedar FUERA del repositorio.
# Por defecto: carpeta hermana del repositorio llamada <repositorio>-worktrees.
# PORTAL_WORKTREES_DIR=../portal-ia-worktrees
