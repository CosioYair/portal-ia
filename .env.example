# Copia este archivo a .env (en la raíz) y ajusta si hace falta. Ningún valor es obligatorio.

# Puerto y host del backend local. Por seguridad solo escucha en localhost.
PORTAL_PORT=4310
PORTAL_HOST=127.0.0.1

# Carpeta de datos (bases SQLite, clave maestra de cifrado). Relativa a la raíz del repo o absoluta.
PORTAL_DATA_DIR=./data

# NUNCA pongas aquí claves de API de proveedores: se introducen desde la interfaz
# y se guardan cifradas (AES-256-GCM) en la base de datos local.
