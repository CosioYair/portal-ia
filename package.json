{
  "name": "portal-ia",
  "private": true,
  "version": "0.12.1",
  "description": "Portal IA — sistema operativo empresarial multiagente, local-first (nombre provisional)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/server & npm run dev --workspace apps/web & wait",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "node scripts/portal-start.mjs",
    "start:server": "npm run start --workspace apps/server",
    "start:edition": "node scripts/portal-edition-start.mjs",
    "edition:build": "tsx apps/server/scripts/build-edition.ts",
    "edition:try": "npm run edition:try --workspace apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
